__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing and linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter Notebooks
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# MLflow tracking
mlruns/
mlartifacts/
*.db

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE configurations
.idea/
.vscode/
*.swp
*.swo

# DVC - Git tracks .dvc files and dvc.lock, ignores the large data and model artifacts
# Note: DVC commands will append their own rules, but we explicitly guard data and model artifacts
data/raw/*
!data/raw/.gitkeep
!data/raw/*.dvc
data/interim/*
!data/interim/.gitkeep
!data/interim/*.dvc
data/processed/*
!data/processed/.gitkeep
!data/processed/*.dvc
models/*
!models/.gitkeep
!models/*.dvc
